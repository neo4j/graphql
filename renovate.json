{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices"],
    "baseBranchPatterns": ["dev", "lts"],
    "rebaseWhen": "auto",
    "automerge": true,
    "major": {
        "automerge": false
    },
    "timezone": "Europe/London",
    "schedule": ["* 0-4 1,15 * *"],
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**",
        "**/__fixtures__/**"
    ],
    "ignoreDeps": ["neo4j"],
    "separateMajorMinor": true,
    "minimumReleaseAge": "3 days",
    "packageRules": [
        {
            "matchUpdateTypes": ["major"],
            "groupName": null,
            "automerge": false
        },
        {
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "minor-and-patch",
            "automerge": true
        },
        {
            "matchFileNames": ["packages/package-tests/graphql-15/package.json"],
            "allowedVersions": "15",
            "matchPackageNames": ["/graphql/"],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "msw 2.13+ depends on ESM-only rettime, which Jest cannot load (https://github.com/mswjs/msw/issues/2698)",
            "matchPackageNames": ["msw"],
            "allowedVersions": "<2.13.0",
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "Vulnerability alerts do not cover the Node runtime, so Node releases skip the schedule",
            "matchDatasources": ["node-version", "docker"],
            "matchDepNames": ["node", "node-previous-lts"],
            "schedule": ["at any time"]
        },
        {
            "description": "reusable-package-tests.yml pins the minimum supported Node engine, so its node-version must not be bumped",
            "matchDepNames": ["node"],
            "matchFileNames": [".github/workflows/reusable-package-tests.yml"],
            "enabled": false
        },
        {
            "description": "The second entry of the nightly integration test matrix is the previous LTS Node line, so it must only be bumped within its current major - update this major when deliberately moving that lane to a newer LTS line",
            "matchDepNames": ["node-previous-lts"],
            "allowedVersions": "24"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update the npm version pinned in the release workflow",
            "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
            "matchStrings": ["npm install -g npm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            "depNameTemplate": "npm",
            "datasourceTemplate": "npm"
        },
        {
            "customType": "regex",
            "description": "Update the current Node release pinned first in the nightly integration test matrix",
            "managerFilePatterns": ["/^\\.github/workflows/reusable-integration-tests-on-prem-nightly\\.yml$/"],
            "matchStrings": ["node: \\[\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
            "depNameTemplate": "node",
            "datasourceTemplate": "node-version"
        },
        {
            "customType": "regex",
            "description": "Update the previous LTS Node version pinned last in the nightly integration test matrix",
            "managerFilePatterns": ["/^\\.github/workflows/reusable-integration-tests-on-prem-nightly\\.yml$/"],
            "matchStrings": [",\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\s*\\]"],
            "depNameTemplate": "node-previous-lts",
            "packageNameTemplate": "node",
            "datasourceTemplate": "node-version"
        }
    ]
}
