{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices"],
    "baseBranchPatterns": ["dev", "lts"],
    "rebaseWhen": "auto",
    "automerge": true,
    "major": {
        "automerge": false
    },
    "timezone": "Europe/London",
    "schedule": ["* 0-4 1,15 * *"],
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**",
        "**/__fixtures__/**"
    ],
    "ignoreDeps": ["neo4j"],
    "separateMajorMinor": true,
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            "matchUpdateTypes": ["major"],
            "groupName": null,
            "automerge": false
        },
        {
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "minor-and-patch",
            "automerge": true
        },
        {
            "matchFileNames": ["packages/package-tests/graphql-15/package.json"],
            "allowedVersions": "15",
            "matchPackageNames": ["/graphql/"]
        },
        {
            "description": "msw 2.13+ depends on ESM-only rettime, which Jest cannot load (https://github.com/mswjs/msw/issues/2698)",
            "matchPackageNames": ["msw"],
            "allowedVersions": "<2.13.0"
        },
        {
            "description": "Vulnerability alerts do not cover the Node runtime, so Node releases skip the release age wait and the schedule",
            "matchDatasources": ["node-version", "docker"],
            "matchDepNames": ["node"],
            "minimumReleaseAge": null,
            "schedule": ["at any time"]
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update the npm version pinned in the release workflow",
            "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
            "matchStrings": ["npm install -g npm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            "depNameTemplate": "npm",
            "datasourceTemplate": "npm"
        }
    ]
}
