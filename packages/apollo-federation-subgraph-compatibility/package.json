{
    "name": "apollo-federation-subgraph-compatibility",
    "version": "1.0.0",
    "packageManager": "yarn@4.12.0",
    "scripts": {
        "build": "webpack --config webpack.config.js",
        "test:docker": "yarn build && fedtest docker --compose docker-compose.yml --schema schema.graphql",
        "test:pm2": "yarn build && fedtest pm2 --endpoint http://localhost:4001 --config subgraph.config.js"
    },
    "dependencies": {
        "@apollo/server": "^5.0.0",
        "@graphql-tools/wrap": "^11.0.0",
        "@neo4j/graphql": "^1.0.0",
        "graphql": "16.12.0",
        "graphql-tag": "^2.12.6",
        "neo4j-driver": "^5.8.0"
    },
    "devDependencies": {
        "@apollo/federation-subgraph-compatibility": "2.2.2",
        "fork-ts-checker-webpack-plugin": "9.1.0",
        "ts-loader": "9.5.4",
        "tsconfig-paths-webpack-plugin": "4.2.0",
        "typescript": "5.9.3",
        "webpack": "5.103.0"
    }
}
