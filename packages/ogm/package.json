        "neo4j-driver": "^5.8.0"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "camelcase": "6.3.0",
        "jsonwebtoken": "9.0.3",
        "pluralize": "8.0.0",
        "randomstring": "1.3.1",
        "semver": "7.7.4",
        "typescript": "5.9.3",
        "vitest": "4.1.12"
    }
